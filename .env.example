# Copy to .env and replace the values. .env is ignored by Git.
# Choose one provider. For DeepSeek, uncomment the next lines and set your key.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-flash
# Optional: defaults to https://api.deepseek.com/responses
# DEEPSEEK_ENDPOINT=https://api.deepseek.com/responses
# Optional: none, low, high, or max. Omit for the model default.
# DEEPSEEK_REASONING_EFFORT=low

# For OpenAI instead, set LLM_PROVIDER=openai and configure:
# OPENAI_API_KEY=replace-with-your-openai-key
# OPENAI_MODEL=gpt-5.4
# OPENAI_REASONING_SUMMARY=auto
